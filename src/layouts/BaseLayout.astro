---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LenisScroller from '../components/react/LenisScroller';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
}

const {
  title = "Amal Raj — Developer, Tinkerer & Vibe Coder",
  description = "Personal portfolio of Amal Raj. Building full-stack web applications with Python & Django, exploring Wayland on Linux, and vibe-coding tools.",
  image = "/og-image.png",
  articleDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://im-amal-raj.github.io');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- MANDATORY: Declare support for dark mode to prevent FOUC -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />

    <!-- Canonical & SEO -->
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Amal Raj" />

    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />
    <meta property="twitter:creator" content="@imamalraj" />

    {articleDate && (
      <meta property="article:published_time" content={articleDate.toISOString()} />
    )}
  </head>
  <body class="bg-black text-neutral-100 min-h-screen flex flex-col font-sans antialiased selection:bg-sky-500/30 selection:text-sky-200 relative overflow-x-hidden">
    <!-- Atmospheric Ambient Lighting Layer -->
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(14,165,233,0.12),transparent_70%)]"></div>
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

    <!-- Momentum Smooth Scroller -->
    <LenisScroller client:load />

    <Header />
    <main id="main-content" class="container mx-auto max-w-4xl px-4 sm:px-6 flex-1 flex flex-col">
      <slot />
    </main>
    <Footer />
  </body>
</html>
