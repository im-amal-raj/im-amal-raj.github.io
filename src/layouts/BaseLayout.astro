---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Amal Raj — Full-Stack Developer",
  description = "Portfolio of Amal Raj. Building web applications with Python & Django.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://im-amal-raj.github.io');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f0e6" />

    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Amal Raj" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-[var(--color-accent)] selection:text-[var(--color-surface)]">
    <slot />
  </body>
</html>
