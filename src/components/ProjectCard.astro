---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, tagline, category, badge, metrics, tech, github, heroImage } = project.data;
---

<article class="project-card glass-panel glass-panel-interactive">
  {heroImage && (
    <div class="card-media">
      <img
        src={heroImage}
        alt={`Screenshot of ${title}`}
        width="600"
        height="320"
        fetchpriority={index === 0 ? "high" : undefined}
        loading={index === 0 ? undefined : "lazy"}
        decoding="async"
        class="card-image"
      />
      <div class="media-gradient"></div>
    </div>
  )}

  <div class="card-content">
    <div class="card-header">
      <div class="card-meta">
        <span class="category-pill">{category}</span>
        {badge && <span class="pill-badge active">{badge}</span>}
      </div>

      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="repo-link"
          aria-label={`View ${title} on GitHub`}
          title="GitHub Repository"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>
      )}
    </div>

    <h3 class="card-title text-title-3">
      {title}
    </h3>

    <p class="card-tagline text-body">
      {tagline}
    </p>

    {metrics && metrics.length > 0 && (
      <div class="card-telemetry">
        {metrics.map((m) => (
          <div class="telemetry-item">
            <span class="tel-value">{m.value}</span>
            <span class="tel-label">{m.label}</span>
          </div>
        ))}
      </div>
    )}

    {tech && tech.length > 0 && (
      <div class="tech-row">
        {tech.map((t) => (
          <span class="tech-tag">{t}</span>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #09090b;
    border-bottom: 1px solid var(--border-subtle);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--spring-standard);
  }

  .project-card:hover .card-image {
    transform: scale(1.02);
  }

  .media-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(0, 0, 0, 0.4) 100%);
    pointer-events: none;
  }

  .card-content {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-3);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .category-pill {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
  }

  .repo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--text-secondary);
    transition: color var(--spring-micro), background var(--spring-micro);
  }

  .repo-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .card-title {
    color: var(--text-primary);
    margin-top: -2px;
  }

  .card-tagline {
    font-size: 15px;
    line-height: 22px;
    color: var(--text-secondary);
    flex: 1;
  }

  .card-telemetry {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin: var(--space-1) 0;
  }

  .telemetry-item {
    display: flex;
    flex-direction: column;
  }

  .tel-value {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-blue);
    font-feature-settings: "tnum" 1;
  }

  .tel-label {
    font-size: 10px;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .tech-tag {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }
</style>
