---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, tagline, category, badge, tech, github, demo, heroImage } = project.data;
---

<article class="group flex flex-col overflow-hidden rounded-[20px] bg-neutral-900/60 backdrop-blur-xl border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1),0_12px_32px_-8px_rgba(0,0,0,0.6)] hover:border-white/20 hover:bg-neutral-900/80 transition-all duration-300 hover:-translate-y-1">
  {heroImage && (
    <div class="relative w-full aspect-[16/9] overflow-hidden bg-black/40 border-b border-white/10">
      <img
        src={heroImage}
        alt={`Screenshot of ${title}`}
        width="640"
        height="360"
        fetchpriority={index === 0 ? "high" : undefined}
        loading={index === 0 ? undefined : "lazy"}
        decoding="async"
        class="w-full h-full object-cover object-top transition-transform duration-500 ease-[cubic-bezier(0.16,1.0,0.3,1.0)] group-hover:scale-[1.03]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
    </div>
  )}

  <div class="p-6 flex flex-col flex-1 gap-4">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400">{category}</span>
        {badge && (
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-sky-500/10 text-sky-400 border border-sky-500/20">
            {badge}
          </span>
        )}
      </div>

      <div class="flex items-center gap-1.5">
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center rounded-full text-neutral-400 hover:text-white hover:bg-white/10 transition-colors duration-150"
            aria-label={`Live demo for ${title}`}
            title="Live Demo"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        )}
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center rounded-full text-neutral-400 hover:text-white hover:bg-white/10 transition-colors duration-150"
            aria-label={`View ${title} on GitHub`}
            title="GitHub Repository"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        )}
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <h3 class="text-white text-lg font-semibold tracking-tight group-hover:text-sky-400 transition-colors duration-150">
        {title}
      </h3>
      <p class="text-neutral-300 text-sm leading-relaxed">
        {tagline}
      </p>
    </div>

    {tech && tech.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
        {tech.map((t) => (
          <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-white/5 text-neutral-300 border border-white/5">
            {t}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
