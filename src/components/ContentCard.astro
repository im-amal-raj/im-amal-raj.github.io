---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, category, readTime, externalUrl, tags } = entry.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(pubDate);

const targetHref = externalUrl || `/writing/${entry.slug}`;
const isExternal = Boolean(externalUrl);
---

<article class="group flex flex-col p-6 rounded-[20px] bg-neutral-900/60 backdrop-blur-xl border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1),0_12px_32px_-8px_rgba(0,0,0,0.6)] hover:border-white/20 hover:bg-neutral-900/80 transition-all duration-300 hover:-translate-y-1">
  <div class="flex items-center justify-between gap-3 text-xs text-neutral-400 mb-3">
    <div class="flex items-center gap-2">
      <span class="font-semibold uppercase tracking-wider text-sky-400 text-[11px]">{category}</span>
      <span>·</span>
      <time datetime={pubDate.toISOString()} class="text-neutral-400">{formattedDate}</time>
      {readTime && (
        <>
          <span>·</span>
          <span>{readTime}</span>
        </>
      )}
    </div>

    {isExternal && (
      <span class="inline-flex items-center gap-1 text-[11px] font-medium text-neutral-400 bg-white/5 px-2 py-0.5 rounded-full border border-white/10">
        <span>Dev.to</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </span>
    )}
  </div>

  <a
    href={targetHref}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class="flex flex-col gap-2 flex-1"
  >
    <h3 class="text-white text-base sm:text-lg font-semibold tracking-tight group-hover:text-sky-400 transition-colors duration-150 leading-snug">
      {title}
    </h3>
    <p class="text-neutral-300 text-sm leading-relaxed">
      {description}
    </p>
  </a>

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-white/5">
      {tags.map((tag) => (
        <span class="text-[11px] text-neutral-400 font-mono">#{tag}</span>
      ))}
    </div>
  )}
</article>
