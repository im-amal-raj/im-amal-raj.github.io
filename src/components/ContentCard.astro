---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, category, readTime, tags } = entry.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(pubDate);
---

<article class="content-card glass-panel glass-panel-interactive">
  <div class="content-header">
    <div class="meta-row">
      <span class="category-pill">{category}</span>
      <span class="meta-separator">·</span>
      <time datetime={pubDate.toISOString()} class="meta-date">{formattedDate}</time>
      {readTime && (
        <>
          <span class="meta-separator">·</span>
          <span class="meta-readtime">{readTime}</span>
        </>
      )}
    </div>

    <span class="type-pill">Devlog</span>
  </div>

  <a href={`/writing/${entry.slug}`} class="content-body">
    <h3 class="content-title text-title-3">
      {title}
    </h3>
    <p class="content-desc text-body">
      {description}
    </p>
  </a>

  {tags && tags.length > 0 && (
    <div class="tags-row">
      {tags.map((tag) => (
        <span class="tag-pill">#{tag}</span>
      ))}
    </div>
  )}
</article>

<style>
  .content-card {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .content-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }

  .category-pill {
    font-weight: 600;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 11px;
  }

  .meta-separator {
    color: var(--text-tertiary);
  }

  .meta-date, .meta-readtime {
    color: var(--text-secondary);
  }

  .type-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-tertiary);
    font-size: 11px;
    font-weight: 500;
    border: 1px solid var(--border-subtle);
  }

  .content-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .content-title {
    color: var(--text-primary);
    transition: color var(--spring-micro);
  }

  .content-card:hover .content-title {
    color: var(--accent-blue);
  }

  .content-desc {
    font-size: 15px;
    line-height: 22px;
    color: var(--text-secondary);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .tag-pill {
    font-size: 11px;
    color: var(--text-tertiary);
  }
</style>
