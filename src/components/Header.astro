---
interface Props {
  activeSection?: string;
}

const { activeSection } = Astro.props;
---

<header class="sticky top-4 z-50 flex justify-center px-4 pointer-events-none">
  <nav
    class="pointer-events-auto flex items-center gap-5 sm:gap-6 px-4 py-2 rounded-pill bg-neutral-900/80 backdrop-blur-2xl border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.12),0_12px_32px_-8px_rgba(0,0,0,0.7)] transition-all duration-300 hover:border-white/20 hover:bg-neutral-900/90"
    aria-label="Main Navigation"
  >
    <a href="/" class="flex items-center gap-2 text-sm font-semibold tracking-tight text-white group" aria-label="Amal Raj Home">
      <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
      <span class="group-hover:text-sky-400 transition-colors duration-150">amal raj</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2 text-[13px] font-medium text-neutral-400">
      <a href="/#projects" class="px-2.5 py-1.5 rounded-lg hover:text-white hover:bg-white/5 transition-all duration-150">Projects</a>
      <a href="/#writing" class="px-2.5 py-1.5 rounded-lg hover:text-white hover:bg-white/5 transition-all duration-150">Writing</a>
      <a href="/#about" class="px-2.5 py-1.5 rounded-lg hover:text-white hover:bg-white/5 transition-all duration-150">About</a>
    </div>

    <div class="flex items-center gap-1 pl-3 border-l border-white/10">
      <a
        href="https://github.com/im-amal-raj"
        target="_blank"
        rel="noopener noreferrer"
        class="w-8 h-8 flex items-center justify-center rounded-full text-neutral-400 hover:text-white hover:bg-white/10 transition-all duration-150"
        aria-label="GitHub Profile"
        title="GitHub"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <a
        href="mailto:amalMraj@proton.me"
        class="w-8 h-8 flex items-center justify-center rounded-full text-neutral-400 hover:text-sky-400 hover:bg-white/10 transition-all duration-150"
        aria-label="Send Email"
        title="Email"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
    </div>
  </nav>
</header>
