---
interface Props {
  activeSection?: string;
}

const { activeSection } = Astro.props;
---

<header class="island-nav-wrapper">
  <nav class="island-nav" aria-label="Main Navigation">
    <a href="/" class="nav-brand" aria-label="Amal Raj Home">
      <span class="status-indicator" title="System Active"></span>
      <span class="brand-text">amal raj</span>
    </a>

    <div class="nav-links">
      <a href="/#projects" class="nav-link">Projects</a>
      <a href="/#writing" class="nav-link">Writing</a>
      <a href="/#about" class="nav-link">About</a>
    </div>

    <div class="nav-actions">
      <a
        href="https://github.com/im-amal-raj"
        target="_blank"
        rel="noopener noreferrer"
        class="icon-action"
        aria-label="GitHub Profile"
        title="GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <a
        href="mailto:amalMraj@proton.me"
        class="icon-action"
        aria-label="Send Email"
        title="Email"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .island-nav-wrapper {
    position: sticky;
    top: var(--space-4);
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 var(--space-4);
    pointer-events: none;
  }

  .island-nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: 8px 16px;
    background: var(--surface-1);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--glass-inner-shadow), 0 8px 24px -4px rgba(0, 0, 0, 0.5);
    border-radius: var(--radius-pill);
    transition: transform var(--spring-standard), background var(--spring-standard), border-color var(--spring-standard);
  }

  .island-nav:hover {
    background: var(--surface-2);
    border-color: var(--border-active);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--text-primary);
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-green);
    box-shadow: 0 0 8px var(--accent-green);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: color var(--spring-micro), background var(--spring-micro);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-3);
  }

  .icon-action {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--text-secondary);
    transition: color var(--spring-micro), background var(--spring-micro);
  }

  .icon-action:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 520px) {
    .island-nav {
      gap: var(--space-3);
      padding: 6px 12px;
    }
    .brand-text {
      display: none;
    }
  }
</style>
