---
---

<section class="hero-section">
  <div class="hero-badge-row">
    <div class="pill-badge live">
      <span class="pulse-dot"></span>
      <span>Anti-Bloat Systems Engineer</span>
    </div>
    <div class="pill-badge">
      <span>Rust · Linux · Slint</span>
    </div>
  </div>

  <h1 class="hero-title text-large-title">
    Amal Raj
  </h1>

  <p class="hero-subtitle text-headline">
    Engineering Apple-grade interface fluidity on Wayland, zero-latency Rust CLI tools, and constraint-tested systems.
  </p>

  <p class="hero-description text-body">
    Creator of <strong class="text-white">rust-island</strong>, <strong class="text-white">yt-hunter</strong>, and the Noctalia desktop ecosystem. Focused on radical minimalism, zero Electron bloat, and WWDC fluid spring physics on Linux.
  </p>

  <div class="hero-cta-group">
    <a href="#projects" class="button-primary">
      <span>Explore Projects</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </a>

    <a
      href="https://www.youtube.com/@amalrajm"
      target="_blank"
      rel="noopener noreferrer"
      class="button-secondary"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
      </svg>
      <span>Watch Devlogs</span>
    </a>

    <a href="#writing" class="button-glass">
      <span>Read Benchmarks</span>
    </a>
  </div>
</section>

<style>
  .hero-section {
    padding: var(--space-12) 0 var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-green);
    display: inline-block;
  }

  .hero-title {
    color: var(--text-primary);
    font-size: clamp(34px, 5vw, 44px);
    line-height: 1.15;
    margin-top: var(--space-2);
  }

  .hero-subtitle {
    color: var(--text-primary);
    font-weight: 500;
    max-width: 680px;
    font-size: 19px;
    line-height: 26px;
  }

  .hero-description {
    max-width: 640px;
    color: var(--text-secondary);
  }

  .text-white {
    color: var(--text-primary);
    font-weight: 500;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  /* Apple HIG Interactive Touch / Click Targets */
  .button-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 20px;
    background: var(--accent-blue);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.2px;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 14px -2px rgba(10, 132, 255, 0.45);
    transition: transform var(--spring-micro), background var(--spring-micro);
  }

  .button-primary:hover {
    background: #0077ed;
    transform: translateY(-1px);
  }

  .button-primary:active {
    transform: scale(0.98);
  }

  .button-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 18px;
    background: rgba(255, 69, 58, 0.12);
    color: #ff6961;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.2px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 69, 58, 0.25);
    transition: transform var(--spring-micro), background var(--spring-micro);
  }

  .button-secondary:hover {
    background: rgba(255, 69, 58, 0.20);
    transform: translateY(-1px);
  }

  .button-secondary:active {
    transform: scale(0.98);
  }

  .button-glass {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    background: var(--surface-1);
    color: var(--text-secondary);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.2px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--glass-inner-shadow);
    transition: transform var(--spring-micro), color var(--spring-micro), background var(--spring-micro);
  }

  .button-glass:hover {
    color: var(--text-primary);
    background: var(--surface-2);
    transform: translateY(-1px);
  }

  .button-glass:active {
    transform: scale(0.98);
  }
</style>
