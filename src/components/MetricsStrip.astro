---
const receipts = [
  {
    value: "18 MB",
    unit: "RSS",
    label: "Dynamic Island Bar",
    detail: "Native Wayland vs 350MB+ Electron bars",
    accent: "text-sky-400",
  },
  {
    value: "< 50 ms",
    unit: "p99",
    label: "Single-Pass Query",
    detail: "Direct InnerTube API in compiled Rust",
    accent: "text-emerald-400",
  },
  {
    value: "1.3 ms",
    unit: "DSP",
    label: "PipeWire Audio Pipeline",
    detail: "Real-time kernel filters on CachyOS",
    accent: "text-sky-400",
  },
  {
    value: "0 KB",
    unit: "client bloat",
    label: "Static Page Delivery",
    detail: "Pure Astro SSR-ready static delivery",
    accent: "text-emerald-400",
  },
];
---

<section class="py-6 sm:py-8" aria-label="Terminal Receipts & Hardware Benchmarks">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
    {receipts.map((r) => (
      <div class="p-4 sm:p-5 rounded-[20px] bg-neutral-900/60 backdrop-blur-xl border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1),0_8px_24px_-6px_rgba(0,0,0,0.5)] flex flex-col justify-between gap-2.5 transition-all duration-200 hover:border-white/20 hover:-translate-y-0.5 group">
        <div class="flex items-baseline justify-between gap-2">
          <span class={`font-mono text-xl sm:text-2xl font-bold tracking-tight tabular-nums ${r.accent}`}>
            {r.value}
          </span>
          <span class="font-mono text-[10px] uppercase tracking-wider text-neutral-400 bg-white/5 px-1.5 py-0.5 rounded border border-white/5">
            {r.unit}
          </span>
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="text-xs font-semibold text-white tracking-tight group-hover:text-neutral-100">
            {r.label}
          </span>
          <span class="text-[11px] text-neutral-400 leading-snug line-clamp-2">
            {r.detail}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
