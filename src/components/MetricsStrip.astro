---
const metrics = [
  { value: "< 18 MB", label: "RAM Ceiling", detail: "Slint + Wayland" },
  { value: "120 FPS", label: "Spring Physics", detail: "WWDC Damped" },
  { value: "< 45 ms", label: "CLI Query Latency", detail: "Rust yt-hunter" },
  { value: "0 kB", label: "Client Bloat", detail: "Astro Core Vitals" },
];
---

<section class="metrics-container" aria-label="Systems Telemetry">
  <div class="metrics-grid">
    {metrics.map((m) => (
      <div class="metric-card glass-panel">
        <span class="metric-value">{m.value}</span>
        <span class="metric-label">{m.label}</span>
        <span class="metric-detail">{m.detail}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .metrics-container {
    padding: var(--space-4) 0 var(--space-8);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .metric-card {
    padding: var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-radius: var(--radius-md);
  }

  .metric-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    font-feature-settings: "tnum" 1;
    letter-spacing: -0.2px;
  }

  .metric-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .metric-detail {
    font-size: 11px;
    color: var(--text-tertiary);
    margin-top: 1px;
  }

  @media (max-width: 768px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
