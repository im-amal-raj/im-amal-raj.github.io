---
const receipts = [
  {
    value: "18 MB",
    label: "rust-island RSS",
    detail: "Native Wayland vs 350MB+ Electron bars",
  },
  {
    value: "< 50 ms",
    label: "yt-hunter Latency",
    detail: "Direct InnerTube API in single-pass Rust",
  },
  {
    value: "0 CPU Spike",
    label: "PipeWire DSP Stack",
    detail: "DeepFilterNet 3 in kernel loop on $15 mic",
  },
  {
    value: "0 KB JS",
    label: "Client Runtime",
    detail: "Pure static Astro with zero client bloat",
  },
];
---

<section class="receipts-container" aria-label="Terminal Receipts & Benchmarks">
  <div class="receipts-grid">
    {receipts.map((r) => (
      <div class="receipt-card glass-panel">
        <span class="receipt-value">{r.value}</span>
        <span class="receipt-label">{r.label}</span>
        <span class="receipt-detail">{r.detail}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .receipts-container {
    padding: var(--space-4) 0 var(--space-8);
  }

  .receipts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .receipt-card {
    padding: var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-radius: var(--radius-md);
  }

  .receipt-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--accent-blue);
    font-feature-settings: "tnum" 1;
    letter-spacing: -0.2px;
    font-family: var(--font-mono);
  }

  .receipt-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 4px;
  }

  .receipt-detail {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 3px;
    line-height: 16px;
  }

  @media (max-width: 900px) {
    .receipts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .receipts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
