---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-white/10 bg-neutral-950/70 py-12">
  <div class="container mx-auto max-w-4xl px-4 sm:px-6 flex flex-col sm:flex-row justify-between items-start gap-8">
    <div class="flex flex-col gap-2 max-w-sm">
      <div class="flex items-center gap-2 text-sm font-semibold text-white tracking-tight">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Amal Raj</span>
      </div>
      <p class="text-xs text-neutral-400 leading-relaxed">
        Developer based in Kerala, India. Building web applications and experimenting with Linux desktop tools.
      </p>
      <p class="text-[11px] text-neutral-500 mt-2">
        © {currentYear} Amal Raj. Hosted on GitHub Pages.
      </p>
    </div>

    <div class="flex gap-10 sm:gap-16">
      <div class="flex flex-col gap-2 text-xs">
        <span class="font-semibold uppercase tracking-wider text-neutral-400 mb-1">Projects</span>
        <a href="#projects" class="text-neutral-400 hover:text-white transition-colors duration-150">Dynamic Island</a>
        <a href="#projects" class="text-neutral-400 hover:text-white transition-colors duration-150">RestroBill</a>
        <a href="#projects" class="text-neutral-400 hover:text-white transition-colors duration-150">Event Organizer</a>
      </div>

      <div class="flex flex-col gap-2 text-xs">
        <span class="font-semibold uppercase tracking-wider text-neutral-400 mb-1">Connect</span>
        <a href="https://github.com/im-amal-raj" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors duration-150">GitHub</a>
        <a href="https://www.linkedin.com/in/im-amal-raj/" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors duration-150">LinkedIn</a>
        <a href="https://dev.to/im-amal-raj" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors duration-150">Dev.to</a>
        <a href="mailto:amalMraj@proton.me" class="text-neutral-400 hover:text-sky-400 transition-colors duration-150">Email</a>
      </div>
    </div>
  </div>
</footer>
