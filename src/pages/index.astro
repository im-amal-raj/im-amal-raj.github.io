---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalTimePill from '../components/react/LocalTimePill';
import CopyEmailPill from '../components/react/CopyEmailPill';
import InteractiveProjects from '../components/react/InteractiveProjects';
import ScrollToTop from '../components/react/ScrollToTop';
import ThemeToggle from '../components/react/ThemeToggle';

const rawProjects = await getCollection('projects');
const projects = rawProjects
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    title: p.data.title,
    tagline: p.data.tagline,
    category: p.data.category,
    tech: p.data.tech,
    github: p.data.github,
    highlights: p.data.highlights,
  }));

const writing = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout>
  <!-- Sticky Header -->
  <header class="w-full shadow-[0_1px_0_0_var(--color-border)] bg-[var(--color-canvas)]">
    <nav class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-4">
      <div class="flex items-center gap-3">
        <a
          href="/"
          class="inline-flex min-h-[44px] items-center font-[family-name:var(--font-display)] text-2xl tracking-tight text-[var(--color-text-primary)] hover:opacity-85 transition-opacity"
        >
          Amal Raj
        </a>
      </div>

      <div class="flex items-center gap-2 sm:gap-4 text-sm text-[var(--color-text-secondary)]">
        <a href="#projects" class="inline-flex min-h-[44px] items-center px-2 hover:text-[var(--color-text-primary)] transition-colors">
          Projects
        </a>
        <a href="#writing" class="inline-flex min-h-[44px] items-center px-2 hover:text-[var(--color-text-primary)] transition-colors">
          Writing
        </a>
        <a
          href="https://github.com/im-amal-raj"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center px-2 hover:text-[var(--color-text-primary)] transition-colors"
        >
          GitHub
        </a>
        <ThemeToggle client:load />
      </div>
    </nav>
  </header>

  <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12 sm:py-16 space-y-16">
    <!-- Intro / Hero -->
    <section aria-labelledby="intro-heading" class="space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <LocalTimePill client:idle />
      </div>

      <div class="space-y-3">
        <h1
          id="intro-heading"
          class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl leading-[1.05] tracking-tight text-[var(--color-text-primary)]"
        >
          Amal Raj
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-[var(--color-text-secondary)]">
          Full-stack web developer building with Python &amp; Django.
        </p>
      </div>

      <!-- Interactive Contact & GitHub Actions -->
      <CopyEmailPill
        client:load
        email="amalMraj@proton.me"
        githubUrl="https://github.com/im-amal-raj"
      />
    </section>

    <!-- Projects Section with Interactive Filter Tabs & Disclosure Notes -->
    <section id="projects" aria-labelledby="projects-heading" class="space-y-6">
      <div class="flex items-baseline justify-between">
        <h2
          id="projects-heading"
          class="font-[family-name:var(--font-display)] text-3xl text-[var(--color-text-primary)]"
        >
          Projects
        </h2>
        <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-secondary)]">
          {projects.length} featured builds
        </span>
      </div>

      <InteractiveProjects client:load projects={projects} />
    </section>

    <!-- Writing -->
    <section id="writing" aria-labelledby="writing-heading" class="space-y-6">
      <div class="flex items-baseline justify-between">
        <h2
          id="writing-heading"
          class="font-[family-name:var(--font-display)] text-3xl text-[var(--color-text-primary)]"
        >
          Writing
        </h2>
        <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-secondary)]">
          Technical Articles
        </span>
      </div>

      <div class="divide-y divide-[var(--color-border)] border-t border-b border-[var(--color-border)]">
        {writing.map((post) => (
          <article class="group py-6 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4">
            <div class="space-y-2 max-w-xl">
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)] tracking-tight">
                {post.data.title}
              </h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">
                {post.data.description}
              </p>
              <div class="flex items-center gap-3 font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-secondary)]">
                <span>{post.data.category}</span>
                <span>·</span>
                <span>{post.data.readTime || '5 min read'}</span>
              </div>
            </div>
            {post.data.externalUrl && (
              <a
                href={post.data.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group/link inline-flex min-h-[44px] shrink-0 items-center gap-1 text-sm font-medium text-[var(--color-accent)] hover:underline"
              >
                <span>Read on Dev.to</span>
                <span class="transition-transform group-hover/link:translate-x-1">&rarr;</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full shadow-[0_-1px_0_0_var(--color-border)] bg-[var(--color-canvas)]">
    <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-6 text-sm text-[var(--color-text-secondary)]">
      <span>&copy; {new Date().getFullYear()} Amal Raj</span>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="https://dev.to/im-amal-raj"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center hover:text-[var(--color-text-primary)] transition-colors"
        >
          Dev.to
        </a>
        <a
          href="https://github.com/im-amal-raj"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center hover:text-[var(--color-text-primary)] transition-colors"
        >
          GitHub
        </a>
        <a
          href="mailto:amalMraj@proton.me"
          class="inline-flex min-h-[44px] items-center hover:text-[var(--color-text-primary)] transition-colors"
        >
          Email
        </a>
        <ScrollToTop client:load />
      </div>
    </div>
  </footer>
</BaseLayout>
