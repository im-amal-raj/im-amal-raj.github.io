---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MetricsStrip from '../components/MetricsStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContentCard from '../components/ContentCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout>
  <Hero />
  <MetricsStrip />

  <!-- Featured Projects -->
  <section id="projects" class="section-block">
    <div class="section-header">
      <div class="header-text">
        <h2 class="text-title-1 section-title">Featured Systems & Tools</h2>
        <p class="text-body section-sub">
          Framed by the problems they solve: native compiled binaries, zero-key CLI intelligence, and kernel-level audio DSP.
        </p>
      </div>
    </div>

    <div class="projects-grid">
      {projects.map((project, idx) => (
        <ProjectCard project={project} index={idx} />
      ))}
    </div>
  </section>

  <!-- Systems Writing & Devlogs -->
  <section id="writing" class="section-block">
    <div class="section-header">
      <div class="header-text">
        <h2 class="text-title-1 section-title">Systems Devlogs & Benchmarks</h2>
        <p class="text-body section-sub">
          Deep dives into Linux audio calibration, Wayland layer shells, and constraint-tested optimizations.
        </p>
      </div>

      <div class="pill-badge">
        <span>Devlogs & Receipts</span>
      </div>
    </div>

    <div class="content-grid">
      {articles.map((article) => (
        <ContentCard entry={article} />
      ))}
    </div>
  </section>

  <!-- Systems Ethos Section -->
  <section id="system" class="section-block ethos-block">
    <div class="glass-panel ethos-card">
      <div class="ethos-header">
        <div class="pill-badge">
          <span>Personal Manifesto</span>
        </div>
        <h2 class="text-title-2 ethos-title">The Craft of Apple, The Freedom of Linux</h2>
        <p class="text-body ethos-intro">
          We shouldn't have to choose between software freedom and software craft. I take inspiration from unified memory architectures, silence, ruthless constraint optimization, and typographic discipline—and bring them to the open Linux desktop.
        </p>
      </div>

      <div class="ethos-grid">
        <div class="ethos-item">
          <span class="ethos-num">01</span>
          <h3 class="ethos-item-title text-headline">The Anti-Bloat Doctrine</h3>
          <p class="text-body ethos-desc">
            Software should respect the silicon it runs on. If a utility can run in 15MB of memory with zero garbage-collection pauses, shipping a 300MB runtime is engineering failure.
          </p>
        </div>

        <div class="ethos-item">
          <span class="ethos-num">02</span>
          <h3 class="ethos-item-title text-headline">Design as an Engineering Feature</h3>
          <p class="text-body ethos-desc">
            Polish isn't cosmetic; it reduces cognitive friction. Fluid gestures, tactile click targets, and typographic hierarchy belong in Linux terminals and Wayland desktops just as much as in macOS.
          </p>
        </div>

        <div class="ethos-item">
          <span class="ethos-num">03</span>
          <h3 class="ethos-item-title text-headline">Receipts Over Speculation</h3>
          <p class="text-body ethos-desc">
            Every claim must be backed by terminal logs, frame-time graphs, and reproducible benchmarks. Hardware that sips battery while feeling alive under your fingers.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-block {
    padding: var(--space-10) 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .section-title {
    color: var(--text-primary);
  }

  .section-sub {
    max-width: 600px;
    margin-top: var(--space-1);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }

  .ethos-card {
    padding: var(--space-8);
  }

  .ethos-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .ethos-title {
    color: var(--text-primary);
  }

  .ethos-intro {
    max-width: 720px;
    margin-top: var(--space-1);
    font-size: 16px;
    line-height: 24px;
    color: var(--text-secondary);
  }

  .ethos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .ethos-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ethos-num {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-blue);
    font-family: var(--font-mono);
  }

  .ethos-item-title {
    color: var(--text-primary);
  }

  .ethos-desc {
    font-size: 14px;
    line-height: 22px;
  }

  @media (max-width: 768px) {
    .ethos-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .ethos-card {
      padding: var(--space-5);
    }
  }
</style>
