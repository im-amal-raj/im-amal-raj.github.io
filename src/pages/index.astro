---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContentCard from '../components/ContentCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout>
  <Hero />

  <!-- Featured Projects -->
  <section id="projects" class="section-block">
    <div class="section-header">
      <div class="header-text">
        <h2 class="text-title-1 section-title">Projects I'm Building</h2>
        <p class="text-body section-sub">
          Native Wayland utilities, terminal tools, and audio experiments built to solve my own daily workflow friction.
        </p>
      </div>
    </div>

    <div class="projects-grid">
      {projects.map((project, idx) => (
        <ProjectCard project={project} index={idx} />
      ))}
    </div>
  </section>

  <!-- Systems Writing & Devlogs -->
  <section id="writing" class="section-block">
    <div class="section-header">
      <div class="header-text">
        <h2 class="text-title-1 section-title">Devlogs & Systems Notes</h2>
        <p class="text-body section-sub">
          Notes and benchmarks from building desktop shells, calibrating Linux audio, and profiling memory usage.
        </p>
      </div>

      <div class="pill-badge">
        <span>Articles & Receipts</span>
      </div>
    </div>

    <div class="content-grid">
      {articles.map((article) => (
        <ContentCard entry={article} />
      ))}
    </div>
  </section>

  <!-- About & Philosophy Section -->
  <section id="about" class="section-block ethos-block">
    <div class="glass-panel ethos-card">
      <div class="ethos-header">
        <div class="pill-badge">
          <span>How I Work</span>
        </div>
        <h2 class="text-title-2 ethos-title">Building for Speed, Feel, and Freedom</h2>
        <p class="text-body ethos-intro">
          I'm not writing corporate whitepapers; I vibe code tools that solve my own daily friction on Linux. Here are the simple principles that guide what I build:
        </p>
      </div>

      <div class="ethos-grid">
        <div class="ethos-item">
          <span class="ethos-num">01</span>
          <h3 class="ethos-item-title text-headline">Respecting the Hardware</h3>
          <p class="text-body ethos-desc">
            I started tinkering on older machines where every megabyte mattered. Today it feels common for simple apps to consume hundreds of megabytes of RAM. I prefer lean, native binaries that sip battery and run silently.
          </p>
        </div>

        <div class="ethos-item">
          <span class="ethos-num">02</span>
          <h3 class="ethos-item-title text-headline">Design as a Feature</h3>
          <p class="text-body ethos-desc">
            I love Linux for user ownership, but desktop Linux has often treated visual polish as an afterthought. You shouldn't have to choose between software freedom and fluid interface feedback, good typography, and clean aesthetics.
          </p>
        </div>

        <div class="ethos-item">
          <span class="ethos-num">03</span>
          <h3 class="ethos-item-title text-headline">Real Receipts Over Theories</h3>
          <p class="text-body ethos-desc">
            Every optimization claim should be proven with real terminal logs, frame-time checks, and simple reproducible setups—not marketing buzzwords.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-block {
    padding: var(--space-8) 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .section-title {
    color: var(--text-primary);
    font-size: 26px;
    letter-spacing: -0.3px;
  }

  .section-sub {
    max-width: 600px;
    margin-top: var(--space-1);
    font-size: 15px;
    line-height: 23px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .ethos-card {
    padding: var(--space-8);
  }

  .ethos-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .ethos-title {
    color: var(--text-primary);
    font-size: 22px;
  }

  .ethos-intro {
    max-width: 720px;
    margin-top: var(--space-1);
    font-size: 15px;
    line-height: 24px;
    color: var(--text-secondary);
  }

  .ethos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .ethos-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ethos-num {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-blue);
    font-family: var(--font-mono);
  }

  .ethos-item-title {
    color: var(--text-primary);
    font-size: 16px;
  }

  .ethos-desc {
    font-size: 14px;
    line-height: 22px;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .ethos-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .ethos-card {
      padding: var(--space-5);
    }
  }
</style>
