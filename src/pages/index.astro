---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectShowcase from '../components/react/ProjectShowcase';
import ContentCard from '../components/ContentCard.astro';

const rawProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const projectItems = rawProjects.map((p) => ({
  title: p.data.title,
  tagline: p.data.tagline,
  category: p.data.category,
  badge: p.data.badge,
  tech: p.data.tech,
  github: p.data.github,
  demo: p.data.demo,
  heroImage: p.data.heroImage,
  slug: p.slug,
}));
---

<BaseLayout>
  <Hero />

  <!-- Featured Projects -->
  <section id="projects" class="py-12 sm:py-16 xl:py-20 border-t border-white/10">
    <div class="flex items-end justify-between gap-4 mb-8 flex-wrap">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-sky-400 mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
          <span>Desktop &amp; Web Builds</span>
        </div>
        <h2 class="text-white text-2xl sm:text-3xl font-bold tracking-title">Featured Projects</h2>
        <p class="text-neutral-400 text-sm sm:text-base mt-1.5 max-w-xl">
          Desktop tools, full-stack web applications, and server utilities built to solve practical workflows.
        </p>
      </div>
    </div>

    <!-- Client-visible project showcase with native captures and verified telemetry -->
    <ProjectShowcase client:visible projects={projectItems} />
  </section>

  <!-- Notes & Case Studies Section -->
  <section id="writing" class="py-12 sm:py-16 border-t border-white/10">
    <div class="flex items-end justify-between gap-4 mb-8 flex-wrap">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-sky-400 mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
          <span>Field Notes</span>
        </div>
        <h2 class="text-white text-2xl sm:text-3xl font-bold tracking-title">Notes &amp; Case Studies</h2>
        <p class="text-neutral-400 text-sm sm:text-base mt-1.5 max-w-xl">
          Technical notes on backend systems, Linux desktop setups, and audio pipeline tuning.
        </p>
      </div>
      <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-white/5 text-neutral-300 border border-white/10 font-mono">
        <span>{articles.length} Posts</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {articles.map((article) => (
        <ContentCard entry={article} />
      ))}
    </div>
  </section>
</BaseLayout>
