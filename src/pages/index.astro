---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout>
  <header class="w-full shadow-[0_1px_0_0_var(--color-border)] bg-[var(--color-canvas)]">
    <nav class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-4">
      <a
        href="/"
        class="inline-flex min-h-[44px] items-center font-[family-name:var(--font-display)] text-2xl tracking-tight text-[var(--color-text-primary)]"
      >
        Amal Raj
      </a>
      <div class="flex items-center gap-2 sm:gap-4 text-sm text-[var(--color-text-secondary)]">
        <a href="#projects" class="inline-flex min-h-[44px] items-center px-2 hover:text-[var(--color-text-primary)] transition-colors">
          Projects
        </a>
        <a href="#writing" class="inline-flex min-h-[44px] items-center px-2 hover:text-[var(--color-text-primary)] transition-colors">
          Writing
        </a>
        <a
          href="https://github.com/im-amal-raj"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center px-2 hover:text-[var(--color-text-primary)] transition-colors"
        >
          GitHub
        </a>
      </div>
    </nav>
  </header>

  <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-12 sm:py-16 space-y-16">
    <!-- Intro -->
    <section aria-labelledby="intro-heading" class="space-y-6">
      <h1
        id="intro-heading"
        class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl leading-[1.05] tracking-tight text-[var(--color-text-primary)]"
      >
        Amal Raj
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-[var(--color-text-secondary)]">
        Full-stack web developer building with Python &amp; Django.
      </p>
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="mailto:amalMraj@proton.me"
          class="inline-flex min-h-[44px] items-center rounded-[var(--radius-button)] bg-[var(--color-text-primary)] px-5 py-2 text-sm font-medium text-[var(--color-surface)] hover:bg-[var(--color-accent)] transition-colors"
        >
          amalMraj@proton.me
        </a>
        <a
          href="https://github.com/im-amal-raj"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center rounded-[var(--radius-button)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-2 text-sm font-medium text-[var(--color-text-primary)] hover:border-[var(--color-text-primary)] transition-colors"
        >
          github.com/im-amal-raj
        </a>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" aria-labelledby="projects-heading" class="space-y-6">
      <h2
        id="projects-heading"
        class="font-[family-name:var(--font-display)] text-3xl text-[var(--color-text-primary)]"
      >
        Projects
      </h2>
      <div class="divide-y divide-[var(--color-border)] border-t border-b border-[var(--color-border)]">
        {projects.map((project) => (
          <article class="py-6 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4">
            <div class="space-y-2 max-w-xl">
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">
                {project.data.title}
              </h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">
                {project.data.tagline}
              </p>
              <p class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-secondary)]">
                {project.data.tech.join(' · ')}
              </p>
            </div>
            {project.data.github && (
              <a
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] shrink-0 items-center text-sm font-medium text-[var(--color-accent)] hover:underline"
              >
                Source &rarr;
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- Writing -->
    <section id="writing" aria-labelledby="writing-heading" class="space-y-6">
      <h2
        id="writing-heading"
        class="font-[family-name:var(--font-display)] text-3xl text-[var(--color-text-primary)]"
      >
        Writing
      </h2>
      <div class="divide-y divide-[var(--color-border)] border-t border-b border-[var(--color-border)]">
        {writing.map((post) => (
          <article class="py-6 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4">
            <div class="space-y-2 max-w-xl">
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">
                {post.data.title}
              </h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">
                {post.data.description}
              </p>
            </div>
            {post.data.externalUrl && (
              <a
                href={post.data.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] shrink-0 items-center text-sm font-medium text-[var(--color-accent)] hover:underline"
              >
                Read on Dev.to &rarr;
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="w-full shadow-[0_-1px_0_0_var(--color-border)] bg-[var(--color-canvas)]">
    <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-6 py-6 text-sm text-[var(--color-text-secondary)]">
      <span>&copy; {new Date().getFullYear()} Amal Raj</span>
      <div class="flex items-center gap-4">
        <a
          href="https://dev.to/im-amal-raj"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center hover:text-[var(--color-text-primary)] transition-colors"
        >
          Dev.to
        </a>
        <a
          href="https://github.com/im-amal-raj"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center hover:text-[var(--color-text-primary)] transition-colors"
        >
          GitHub
        </a>
        <a
          href="mailto:amalMraj@proton.me"
          class="inline-flex min-h-[44px] items-center hover:text-[var(--color-text-primary)] transition-colors"
        >
          Email
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
